# CodingIT Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# REQUIRED FOR BASIC FUNCTIONALITY
# =============================================================================

# Site URL (use http://localhost:3000 for development)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database & Authentication (Supabase) - Required for full functionality
# Get these from https://supabase.com -> Your Project -> Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =============================================================================
# AI PROVIDERS (Add at least one for AI functionality)
# =============================================================================

# OpenAI (recommended) - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude) - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Groq - https://console.groq.com
GROQ_API_KEY=

# Together AI - https://api.together.xyz
TOGETHER_API_KEY=

# Fireworks AI - https://fireworks.ai
FIREWORKS_API_KEY=

# Google AI Studio - https://makersuite.google.com
GOOGLE_AI_API_KEY=

# Google Vertex AI (JSON credentials as string)
GOOGLE_VERTEX_CREDENTIALS=

# Mistral AI - https://console.mistral.ai
MISTRAL_API_KEY=

# xAI (Grok) - https://console.x.ai
XAI_API_KEY=

# DeepSeek - https://platform.deepseek.com
DEEPSEEK_API_KEY=

# =============================================================================
# PRODUCTION WEBHOOKS (Only needed for production deployment)
# =============================================================================

# GitHub webhook secret for repository integrations
GITHUB_WEBHOOK_SECRET=

# Stripe webhook secret for payment processing
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# OPTIONAL FEATURES
# =============================================================================

# Rate limiting with Upstash KV
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Analytics with PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# =============================================================================
# FEATURE FLAGS (Uncomment to enable)
# =============================================================================

# Disable API key input in the chat interface
# NEXT_PUBLIC_NO_API_KEY_INPUT=true

# Disable base URL input in the chat interface
# NEXT_PUBLIC_NO_BASE_URL_INPUT=true

# Hide local models from the model selection
# NEXT_PUBLIC_HIDE_LOCAL_MODELS=true

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================

# Maximum requests per window (optional)
RATE_LIMIT_MAX_REQUESTS=

# Rate limit window in seconds (optional)
RATE_LIMIT_WINDOW=